{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI-Employee",
  "version": "0.1.0",
  "identifier": "de.ai-employee.desktop",
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "windows": [
      {
        "title": "AI-Employee",
        "width": 1180,
        "height": 780,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
