# Internal reverse proxy - Cloudflare Tunnel terminates TLS
# Caddy routes requests to the correct backend service
#
# Deployment-specific routes: do NOT edit this tracked file (a git pull would
# clobber your changes). Drop your own `*.caddy` snippets into ./conf.d/ instead
# — they are imported below and are git-ignored, so they survive every update.
#
# Reload caveat: this file is bind-mounted as a SINGLE file
# (./Caddyfile:/etc/caddy/Caddyfile:ro). Editing it with `sed -i` replaces the
# inode, so the container keeps serving the OLD config while `caddy validate`
# and `caddy reload` both report success against the stale file. After such an
# edit, run `docker restart ai-employee-caddy` to actually pick up the change.

# TOP-LEVEL import: whole site blocks that define their OWN hostname (e.g. a
# Cloudflare-Access "bypass" host that must be a separate site — see #374). A
# snippet imported here may open its own `example.com:80 { ... }` block. Extra
# PATHS on the existing host go in conf.d/site/ instead (imported below, inside
# the :80 block). `import` is evaluated before parsing and may appear anywhere;
# an empty glob is not an error in Caddy v2. See conf.d/README.md.
import conf.d/*.caddy

:80 {
	# Security headers (defence in depth — also set by FastAPI middleware)
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(self), geolocation=()"
		-Server
	}

	# Deployment-specific routes on THIS host. Operators add their own handle/route
	# blocks as ./conf.d/site/*.caddy files (see conf.d/README.md). handle blocks
	# are matched most-specific-first, so custom specific paths win over the
	# catch-all below. An empty glob (no *.caddy files) is not an error in Caddy
	# v2. Snippets that need their OWN hostname go in conf.d/ (top-level import).
	import conf.d/site/*.caddy

	# Kiosk is LOCAL-ONLY. Requests coming through the Cloudflare tunnel carry a
	# Cf-Ray header → 404. Requests from the Pi's own browser hit Caddy directly
	# and have no such header → served. (handle blocks are matched most-specific
	# first, so these win over /api/* and the catch-all.)
	@tunnel header Cf-Ray *
	handle /api/v1/kiosk* {
		route {
			respond @tunnel "Not found" 404
			reverse_proxy ai-employee-orchestrator:8000
		}
	}
	handle /kiosk* {
		route {
			respond @tunnel "Not found" 404
			reverse_proxy ai-employee-frontend:3000
		}
	}

	# Feedback-Widget: der save-Pfad traegt einen base64-PNG-Screenshot
	# (~0,2–1 MB, theoretisch bis ~11 MB) — explizites 12MB-Limit statt
	# unbegrenzt; das Backend deckelt das decodierte Bild zusaetzlich bei 8MB.
	# Achtung: laeuft auf dem Host noch ein nginx davor, braucht der fuer
	# diesen Pfad `client_max_body_size 12m;`.
	handle /api/v1/feedback/save {
		request_body {
			max_size 12MB
		}
		reverse_proxy ai-employee-orchestrator:8000
	}

	# API + health endpoints → orchestrator
	handle /api/* {
		reverse_proxy ai-employee-orchestrator:8000
	}

	# Backend healthcheck (for Docker/monitoring) → orchestrator
	# Use /healthz to avoid conflict with frontend /health route
	handle /healthz {
		reverse_proxy ai-employee-orchestrator:8000
	}

	# WebSocket connections → orchestrator
	handle /ws/* {
		reverse_proxy ai-employee-orchestrator:8000
	}

	# OAuth discovery (RFC 8414 / 9728) for the external MCP server — must be at
	# well-known root so MCP clients (OpenWebUI) can find the authorization server.
	handle /.well-known/oauth-authorization-server* {
		reverse_proxy ai-employee-orchestrator:8000
	}
	handle /.well-known/oauth-protected-resource* {
		reverse_proxy ai-employee-orchestrator:8000
	}

	# Immutable hashed build assets (JS/CSS chunks) — safe to cache forever.
	handle /_next/static/* {
		reverse_proxy ai-employee-frontend:3000 {
			header_down Cache-Control "public, max-age=31536000, immutable"
		}
	}

	# Everything else → frontend. The HTML shell must NOT be long-cached by the CDN/
	# browser (Next.js sends s-maxage=1y) — otherwise a new deploy stays invisible
	# because the cached HTML keeps referencing the OLD hashed bundles. header_down
	# overrides the upstream Cache-Control so users always get the current build.
	handle {
		reverse_proxy ai-employee-frontend:3000 {
			header_down Cache-Control "no-cache, must-revalidate"
		}
	}
}
