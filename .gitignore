# Deployment-specific Caddy routes — operators drop *.caddy files into conf.d/.
# conf.d/ holds whole site blocks (own hostname); conf.d/site/ holds extra paths
# on the main host. The directory placeholders and README stay tracked; operator
# routes do not.
/conf.d/*
!/conf.d/.gitkeep
!/conf.d/README.md
!/conf.d/site/
/conf.d/site/*
!/conf.d/site/.gitkeep

# Electron-Build-Artefakte der Desktop-Bridge (1.6 GB, rein generiert)
desktop/release/

# pdf.js-Beiwerk wird beim Build aus node_modules kopiert (generiert)
frontend/public/pdfjs/

# Core-Dumps abgestuerzter Kindprozesse (je ~14 MB, landen im Arbeitsverzeichnis
# des Prozesses). Ohne dieses Muster nimmt ein `git add -A` sie versehentlich mit.
core
core.*
