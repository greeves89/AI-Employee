{
  "allowManagedHooksOnly": true,
  "env": {
    "LD_PRELOAD": "",
    "LD_AUDIT": "",
    "LD_LIBRARY_PATH": "",
    "BASH_ENV": "",
    "ENV": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env -i AI_EMPLOYEE_LAUF=\"$AI_EMPLOYEE_LAUF\" /usr/bin/node /opt/mcp/pretooluse-hook.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
