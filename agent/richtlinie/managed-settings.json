{
  "allowManagedHooksOnly": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env -u NODE_OPTIONS -u NODE_PATH /usr/bin/node /opt/mcp/pretooluse-hook.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
