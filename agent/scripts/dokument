#!/usr/bin/env python3
"""dokument — versandfertige PDF- und Word-Dokumente erzeugen und prüfen (#893).

    dokument pdf  angebot.md -o /workspace/transfer/angebot.pdf [--fusszeile "Firma"]
    dokument docx angebot.md -o /workspace/transfer/angebot.docx
    dokument pruefen /workspace/transfer/angebot.pdf

PDFs NUR hiermit erzeugen, nie mit ``chromium --print-to-pdf``: das druckt die
Kopf-/Fußzeile des Browsers (US-Datum, file://-Pfad) auf jede Seite.
Die Umsetzung steht in ``app/dokument.py``; alle Laufzeiten nutzen dieses eine
Werkzeug über ihre Shell.
"""

import sys
from pathlib import Path

try:
    from app.dokument import main
except ImportError:
    # Außerhalb des Abbilds (Tests im Repo) liegt das Paket neben scripts/.
    sys.modules.pop("app", None)
    sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
    sys.path.insert(1, "/opt/agent")
    from app.dokument import main

sys.exit(main())
